# Database
DATABASE_URL="postgresql://user:password@localhost:5432/york"

# Server
PORT=3000

# CORS
CORS_ORIGIN="http://localhost:3000,https://york-snowy.vercel.app"

# Authentication (JWT)
JWT_SECRET="your-secret-key-here"

# Anthropic API (for Claude integration)
ANTHROPIC_API_KEY="your-key-here"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
